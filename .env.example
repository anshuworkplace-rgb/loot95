# ═══════════════════════════════════════════════════════════════
# LOOT 95 — Production Environment Variables
# ═══════════════════════════════════════════════════════════════

# Server Port
PORT=3001

# Google Gemini API Key (for AI Deal Judge verification)
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# RapidAPI Key (for Real Live Amazon India Data Fetching)
# Get free key at: https://rapidapi.com/real-time-amazon-data
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# PostgreSQL / Supabase Connection (Optional - defaults to persistent JSON store if empty)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
